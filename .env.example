# ── Ma'lumotlar bazasi (PostgreSQL) ──────────────────────────────
# LOKAL (docker-compose): pooler yo'q — ikkalasi bir xil
DATABASE_URL="postgresql://rfm:rfm_parol@localhost:5432/rfm?schema=public"
DIRECT_URL="postgresql://rfm:rfm_parol@localhost:5432/rfm?schema=public"

# NEON namunasi:
#   DATABASE_URL = pooled ulanish (host'da "-pooler" bo'ladi, ...?sslmode=require)
#   DIRECT_URL   = to'g'ridan-to'g'ri ulanish ("-pooler"siz)
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/rfm?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/rfm?sslmode=require"

# SUPABASE namunasi:
#   DATABASE_URL = Transaction pooler (port 6543, ...?pgbouncer=true)
#   DIRECT_URL   = to'g'ridan-to'g'ri (port 5432)
# DATABASE_URL="postgresql://postgres.xxx:pass@aws-0-eu.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxx:pass@aws-0-eu.pooler.supabase.com:5432/postgres"

# ── Autentifikatsiya ─────────────────────────────────────────────
# Ishlab chiqarishda kuchli tasodifiy qiymat qo'ying (masalan: openssl rand -base64 32)
JWT_SECRET="change-me-in-production"
